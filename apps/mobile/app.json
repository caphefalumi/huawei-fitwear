{
  "expo": {
    "name": "VoocHealth",
    "slug": "huawei-fitwear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/voochealth-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fitwear.mobile"
    },
    "android": {
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "package": "com.fitwear.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "../../assets/voochealth-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-build-properties", { "android": { "minSdkVersion": 26 } }],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Read your weight and heart rate when you request them.",
          "NSHealthUpdateUsageDescription": "Save completed workouts you choose to share.",
          "background": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph meals and scan packaged-food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to choose meal photos for nutrition analysis.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph meals and scan packaged-food barcodes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to your Huawei Watch."
        }
      ],
      "./plugins/withBluetoothPermissions",
      "./plugins/withAndroidCmake"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7db03bfd-3c6f-4b96-ab9a-f99315236743"
      },
      "router": {}
    },
    "owner": "caphefalumis-organization"
  }
}
