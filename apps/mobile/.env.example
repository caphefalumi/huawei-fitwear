# Public API endpoint. Use your computer's LAN address for a physical device.
EXPO_PUBLIC_API_URL=https://fitwear.tm-project.id.vn

# Public PostHog client configuration. Values are embedded at build time by Expo.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host
