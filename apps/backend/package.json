{
  "name": "@fitwear/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitwear-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitwear-d1 --remote",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:all": "bun test tests/unit tests/integration",
    "email:sync-resend": "bun run scripts/sync-resend-templates.ts"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3",
    "wrangler": "4"
  },
  "packageManager": "bun"
}
