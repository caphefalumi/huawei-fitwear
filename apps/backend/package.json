{
  "name": "@fitwear/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitwear-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitwear-d1 --remote",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "playwright test",
    "test:all": "bun test tests/unit tests/integration && playwright test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
