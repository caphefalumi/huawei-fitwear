// apps/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================================
// 1. BETTER AUTH MODELS (With User Extended for Biometrics)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth Extended Biometrics & Goals
  gender          String?   // 'male' | 'female' | 'other'
  birthDate       String?   // ISO 'YYYY-MM-DD'
  heightCm        Float?
  currentWeightKg Float?
  targetWeightKg  Float?
  activityLevel   String?   @default("moderately_active")
  fitnessGoal     String?   @default("muscle_gain")
  bmrKcal         Float?    // Calculated Mifflin-St Jeor BMR
  tdeeKcal        Float?    // Calculated TDEE
  proteinTargetG  Float?    // Calculated: currentWeightKg * 1.6

  // Auth Relations
  sessions Session[]
  accounts Account[]

  // Domain Relations
  dailyTargets    DailyTarget[]
  mealLogs        MealLog[]
  workoutSessions WorkoutSession[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String    // 'credential'
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Hashed password for email/password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ============================================================================
// 2. DAILY NUTRITION TARGETS & RING SYNC (Watch 10% Tick Steps)
// ============================================================================

model DailyTarget {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDate        String   // ISO 'YYYY-MM-DD'
  calorieTargetKcal Int
  proteinTargetG    Float
  carbsTargetG      Float
  fatTargetG        Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, targetDate])
  @@index([userId, targetDate])
  @@map("daily_targets")
}

// ============================================================================
// 3. MEAL LOGS & ITEMS (Vision AI & Ground Truth User Edits)
// ============================================================================

model MealLog {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDate          String     // ISO 'YYYY-MM-DD'
  mealType            String     // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  imageUrl            String?
  scaleReferenceType  String?    @default("finger")
  totalCaloriesKcal   Float
  totalProteinG       Float
  totalCarbsG         Float
  totalFatG           Float
  aiConfidenceOverall Float?
  loggedAt            DateTime   @default(now())
  createdAt           DateTime   @default(now())

  items MealItem[]

  @@index([userId, targetDate])
  @@map("meal_logs")
}

model MealItem {
  id               String   @id @default(cuid())
  mealLogId        String
  mealLog          MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  foodName         String
  estimatedWeightG Float
  correctedWeightG Float?   // User manual ground truth edit for accuracy testing
  caloriesKcal     Float
  proteinG         Float
  carbsG           Float
  fatG             Float
  aiConfidence     Float?
  boundingBoxJson  String?  // JSON string: {"ymin":..,"xmin":..,"ymax":..,"xmax":..}
  createdAt        DateTime @default(now())

  @@index([mealLogId])
  @@map("meal_items")
}

// ============================================================================
// 4. EXERCISES & WORKOUT SESSIONS (Watch IMU Rep-Counting & Sets)
// ============================================================================

model Exercise {
  id                  String       @id @default(cuid())
  name                String       @unique
  muscleGroup         String       // 'chest' | 'back' | 'legs' | 'shoulders' | 'arms' | 'core'
  equipment           String       @default("barbell")
  cadenceAnimationUrl String?
  sets                WorkoutSet[]

  @@map("exercises")
}

model WorkoutSession {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTitle     String       // e.g. 'Push Day'
  workoutSplit     String       // 'push' | 'pull' | 'legs'
  avgHeartRateBpm  Int?
  maxHeartRateBpm  Int?
  totalVolumeKg    Float        @default(0)
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  sets WorkoutSet[]

  @@index([userId, startedAt])
  @@map("workout_sessions")
}

model WorkoutSet {
  id                  String         @id @default(cuid())
  workoutSessionId    String
  workoutSession      WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId          String
  exercise            Exercise       @relation(fields: [exerciseId], references: [id])
  setIndex            Int
  weightKg            Float
  targetReps          Int            @default(10)
  detectedReps        Int?           // Reps counted by Watch IMU classifier
  userConfirmedReps   Int            // Reps confirmed on watch
  restDurationSeconds Int?           // Rest buzzer duration (60s, 90s)
  avgHrBpm            Int?
  createdAt           DateTime       @default(now())

  @@index([workoutSessionId])
  @@map("workout_sets")
}
