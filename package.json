{
  "name": "fitwear",
  "private": true,
  "scripts": {
    "postinstall": "bun install --cwd apps/mobile",
    "start": "bun --cwd apps/mobile start",
    "android": "bun --cwd apps/mobile android",
    "ios": "bun --cwd apps/mobile ios",
    "build:ios": "bun --cwd apps/mobile run build:ios",
    "build:android": "bun --cwd apps/mobile run build:android",
    "web": "bun --cwd apps/mobile web",
    "lint": "bun --cwd apps/mobile lint",
    "backend:dev": "bun --cwd apps/backend dev",
    "backend:build": "bun --cwd apps/backend build",
    "backend:typecheck": "bun --cwd apps/backend typecheck",
    "backend:test": "bun --cwd apps/backend test",
    "backend:test:unit": "bun --cwd apps/backend test:unit",
    "backend:test:integration": "bun --cwd apps/backend test:integration",
    "backend:test:e2e": "bun --cwd apps/backend test:e2e",
    "db:generate": "bun --cwd apps/backend db:generate",
    "db:migrate:local": "bun --cwd apps/backend db:migrate:local",
    "db:migrate:remote": "bun --cwd apps/backend db:migrate:remote",
